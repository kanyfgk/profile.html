.vaero-commerce-app{
    min-height:100%;
    padding:28px;
    color:#f6f1e8;
}

.vaero-commerce-header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:24px;
    margin-bottom:28px;
}

.vaero-commerce-eyebrow,
.vaero-product-type,
.vaero-commerce-section-head > span{
    display:block;
    color:#d9b77f;
    font-size:11px;
    font-weight:700;
    letter-spacing:.2em;
}

.vaero-commerce-header h1{
    margin:10px 0 8px;
    font-size:40px;
    line-height:1.04;
    font-weight:500;
    letter-spacing:-.03em;
}

.vaero-commerce-header p{
    max-width:520px;
    margin:0;
    color:rgba(255,255,255,.58);
    font-size:14px;
    line-height:1.65;
}

.vaero-commerce-id-btn{
    display:flex;
    align-items:center;
    gap:14px;
    min-height:44px;
    padding:0 18px;
    border:1px solid rgba(220,184,125,.22);
    border-radius:999px;
    background:rgba(255,255,255,.025);
    color:#f4ecdf;
    cursor:pointer;
}

.vaero-commerce-hero{
    position:relative;
    min-height:330px;
    margin-bottom:30px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.07);
    border-radius:28px;
    background:
        radial-gradient(
            circle at 78% 42%,
            rgba(52,112,160,.22),
            transparent 34%
        ),
        radial-gradient(
            circle at 16% 12%,
            rgba(219,173,107,.12),
            transparent 28%
        ),
        linear-gradient(
            145deg,
            #111924,
            #07111a 62%,
            #050a0f
        );
}

.vaero-commerce-hero::after{
    content:"";
    position:absolute;
    right:-90px;
    bottom:-160px;
    width:440px;
    height:440px;
    border:1px solid rgba(224,188,125,.15);
    border-radius:50%;
    box-shadow:
        0 0 0 36px rgba(224,188,125,.025),
        0 0 0 72px rgba(224,188,125,.018);
}

.vaero-commerce-hero-copy{
    position:relative;
    z-index:2;
    max-width:520px;
    padding:54px;
}

.vaero-commerce-hero-copy > span{
    color:#d6b17b;
    font-size:11px;
    letter-spacing:.16em;
}

.vaero-commerce-hero h2{
    margin:16px 0 12px;
    font-size:46px;
    line-height:1;
    font-weight:500;
    letter-spacing:-.035em;
}

.vaero-commerce-hero p{
    margin:0;
    color:rgba(255,255,255,.6);
    font-size:15px;
}

.vaero-commerce-actions{
    display:flex;
    gap:12px;
    margin-top:28px;
}

.vaero-commerce-actions button,
.vaero-commerce-section-head button{
    border:0;
    background:none;
    color:#e5c28c;
    cursor:pointer;
}

.vaero-commerce-actions button{
    min-height:46px;
    padding:0 20px;
    border:1px solid rgba(224,188,125,.2);
    border-radius:999px;
    background:rgba(255,255,255,.035);
}

.vaero-commerce-actions button:first-child{
    background:linear-gradient(
        135deg,
        #d9b373,
        #f0d39d
    );
    color:#111;
}

.vaero-commerce-section{
    margin-top:8px;
}

.vaero-commerce-section-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:16px;
}

.vaero-commerce-products{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:14px;
}

.vaero-product-card{
    position:relative;
    min-height:210px;
    padding:22px;
    overflow:hidden;
    text-align:left;
    border:1px solid rgba(255,255,255,.07);
    border-radius:22px;
    background:
        radial-gradient(
            circle at 72% 20%,
            rgba(93,144,181,.13),
            transparent 34%
        ),
        linear-gradient(
            145deg,
            rgba(255,255,255,.045),
            rgba(255,255,255,.015)
        );
    color:#fff;
    cursor:pointer;
}

.vaero-product-card::after{
    content:"";
    position:absolute;
    right:-38px;
    top:-34px;
    width:130px;
    height:130px;
    border-radius:50%;
    background:
        radial-gradient(
            circle at 35% 30%,
            rgba(255,255,255,.18),
            rgba(24,43,59,.4) 38%,
            rgba(5,10,16,.85) 72%
        );
    box-shadow:0 20px 45px rgba(0,0,0,.35);
}

.vaero-product-card strong{
    position:absolute;
    left:22px;
    bottom:52px;
    z-index:2;
    font-size:22px;
}

.vaero-product-card small{
    position:absolute;
    left:22px;
    bottom:26px;
    z-index:2;
    color:rgba(255,255,255,.52);
    font-size:12px;
}

@media (max-width:700px){

    .vaero-commerce-app{
        padding:18px 16px 110px;
    }

    .vaero-commerce-header{
        gap:12px;
        margin-bottom:18px;
    }

    .vaero-commerce-header h1{
        font-size:28px;
    }

    .vaero-commerce-header p{
        font-size:12px;
    }

    .vaero-commerce-id-btn{
        min-height:40px;
        padding:0 13px;
        font-size:11px;
    }

    .vaero-commerce-hero{
        min-height:245px;
        margin-bottom:20px;
        border-radius:22px;
    }

    .vaero-commerce-hero-copy{
        padding:28px 22px;
    }

    .vaero-commerce-hero h2{
        font-size:34px;
    }

    .vaero-commerce-actions{
        flex-wrap:wrap;
        margin-top:20px;
    }

    .vaero-commerce-products{
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:8px;
    }

    .vaero-product-card{
        min-height:160px;
        padding:14px 10px;
        border-radius:16px;
    }

    .vaero-product-card::after{
        right:-34px;
        top:-28px;
        width:96px;
        height:96px;
    }

    .vaero-product-card strong{
        left:11px;
        bottom:43px;
        font-size:14px;
    }

    .vaero-product-card small{
        left:11px;
        bottom:20px;
        max-width:90px;
        font-size:9px;
        line-height:1.3;
    }
}
